{
  "name": "asset-radar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run catalog:validate && next build && node scripts/check-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:check": "tsx scripts/check-catalog.ts",
    "catalog:discover": "tsx scripts/discover-assets.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "robots-parser": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
